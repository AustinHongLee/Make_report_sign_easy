{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run GUI (non-blocking)",
			"type": "shell",
			"command": "Start-Process -FilePath (Get-Command pythonw).Source -ArgumentList 'tools/fill_pdf_gui.py'",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "build",
			"type": "shell",
			"command": "msbuild",
			"args": [
				"/property:GenerateFullPaths=true",
				"/t:build",
				"/consoleloggerparameters:NoSummary"
			],
			"group": "build"
		},
		{
			"label": "Build wheel",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Main GUI (non-blocking)",
			"type": "shell",
			"command": "Start-Process -FilePath (Get-Command pythonw).Source -ArgumentList 'tools/main_gui.py'",
			"isBackground": false,
			"group": "build"
		}
	]
}