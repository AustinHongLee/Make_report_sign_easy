{
  // 視覺清潔：隱藏重複或產生物，避免像桌面散落
  "files.exclude": {
    "**/__pycache__": true,
    "previews/**": true,
    "confirm/**": true,
  "docs/logs/**": true,
  // Hide root duplicates moved into docs/
  "DEVELOPMENT_GUIDE.md": true,
  "PROJECT_STRUCTURE.md": true,
    // Phase B 過渡：先隱藏 src 的重複模組，避免與根目錄混淆
    "src/Make_report_sign_easy/**": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "previews/**": true,
    "confirm/**": true,
    "src/Make_report_sign_easy/**": true,
    "DEVELOPMENT_GUIDE.md": true,
    "PROJECT_STRUCTURE.md": true
  },
  // Pylance 排除 src 的重複掃描（目前主套件從根目錄載入）
  "python.analysis.exclude": [
    "src/Make_report_sign_easy/**"
  ],
  // 檔案巢狀顯示，讓相關檔案收合
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "README.md": "README.*.md, *.md",
    "pyproject.toml": "poetry.lock, requirements*.txt, ruff.toml, *.cfg, *.ini",
    "*.py": "*.pyi, *.pyc, *.pyo, *.pyd"
  },
  // 統一行尾與縮排（配合 .editorconfig）
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
